{
  "name": "boutique-backend",
  "version": "1.0.0",
  "description": "Boutique Operations App — Express/MongoDB Backend",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "vitest",
    "create:owner": "node src/scripts/createOwner.js",
    "create:finance": "node src/scripts/createFinanceManager.js",
    "create:purchase": "node src/scripts/createPurchaseManager.js",
    "create:receiving": "node src/scripts/createReceivingStaff.js",
    "create:cashier": "node src/scripts/createCashier.js",
    "jobs:overdue": "node src/jobs/overdueCheck.run.js",
    "jobs:pra-retry": "node src/jobs/praRetry.run.js",
    "jobs:fbr-retry": "npm run jobs:pra-retry",
    "jobs:loyalty": "node src/jobs/loyaltyExpiry.run.js",
    "jobs:billing-reminders": "node src/jobs/billingReminders.run.js",
    "jobs:scheduler": "node src/jobs/scheduler.run.js",
    "jobs:outbox-dispatch": "node src/jobs/outboxDispatch.run.js",
    "jobs:shopify-events": "node src/jobs/shopifyEvents.run.js",
    "workers:critical": "node src/workers/critical.worker.js",
    "workers:tracking": "node src/workers/riderTracking.worker.js",
    "ops:preflight": "node src/scripts/productionPreflight.js",
    "ops:queue-smoke": "node src/scripts/queueSmoke.js",
    "ops:rotate-pra-key:dry-run": "node src/scripts/rotatePraEncryptionKey.js",
    "ops:rotate-pra-key:apply": "node src/scripts/rotatePraEncryptionKey.js --apply",
    "migrate:purchases:dry-run": "node src/scripts/migrateUnifiedPurchases.js --dry-run",
    "migrate:purchases:apply": "node src/scripts/migrateUnifiedPurchases.js --apply",
    "migrate:outlet-features:dry-run": "node src/scripts/migrateOutletFeatureFlags.js",
    "migrate:outlet-features:apply": "node src/scripts/migrateOutletFeatureFlags.js --apply",
    "repair:purchase-numbers:dry-run": "node src/scripts/repairMigratedPurchaseNumbers.js",
    "repair:purchase-numbers:apply": "node src/scripts/repairMigratedPurchaseNumbers.js --apply",
    "backup:purchases": "node src/scripts/backupBeforePurchaseMigration.js",
    "migrate:charge-to-salary:dry-run": "node scripts/migrateChargeToSalaryAccount.js"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@socket.io/redis-streams-adapter": "^0.3.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.0.0",
    "cloudinary": "^2.9.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.1",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "joi": "^18.1.2",
    "jsonwebtoken": "^9.0.3",
    "mailtrap": "^4.5.1",
    "mongoose": "^9.4.1",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "nodemon": "^3.1.14",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.18.0",
    "rate-limit-redis": "^6.0.0",
    "redis": "^6.1.0",
    "socket.io": "^4.7.2",
    "undici": "^8.10.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  }
}
