# Backend environment variables
# Copy this file to .env and fill in your values.
# All variables listed here are REQUIRED unless marked optional.

# ─── Database ─────────────────────────────────────────────────────────────────
# Multi-tenant: per-tenant DBs derive from this base URI + the tenant slug
# (e.g. mongodb://localhost:27017/the-smash-ove). The DB name in MONGO_URI
# is ignored for tenant routing; PLATFORM_DB_NAME holds the registry.
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0
PLATFORM_DB_NAME=platform

# ─── Trial / subscription ─────────────────────────────────────────────────────
TRIAL_DAYS=14

# ─── Initial super-admin (seeded on first boot if missing) ────────────────────
PLATFORM_ADMIN_EMAIL=admin@cenciss.com
PLATFORM_ADMIN_PASSWORD=change_me_long_password
PLATFORM_ADMIN_NAME=Super Admin

# ─── Admin frontend origin (for CORS) ─────────────────────────────────────────
ADMIN_CLIENT_URL=http://localhost:3002

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_another_long_random_string
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=7d

# ─── Shopify (each boutique enters its own app credentials in Settings)
# This shared encryption key protects each boutique's credentials at rest.
SHOPIFY_ENCRYPTION_KEY=replace_with_a_long_random_secret
SHOPIFY_API_VERSION=2026-10
SHOPIFY_EVENT_POLL_MS=1000
SHOPIFY_RECONCILE_CRON=17 * * * *
SHOPIFY_WEBHOOK_BASE_URL=https://api.example.com

# Dedicated at-rest encryption key for PRA/PRAL tokens. During a controlled key
# rotation only, set PRA_ENC_KEY_PREVIOUS to the outgoing key, rotate, then remove it.
PRA_ENC_KEY=change_me_to_a_different_long_random_string
# PRA_ENC_KEY_PREVIOUS=

# PRA's shared sandbox token is published in its eIMS technical specification.
# Restaurants still need their own Test POS ID from the PRA registration portal.
PRA_SANDBOX_TOKEN=replace_with_current_pra_sandbox_token

# Optional static-egress proxy for PRA requests only. Heroku QuotaGuard Static
# automatically supplies QUOTAGUARDSTATIC_URL, so PRA_PROXY_URL is normally unset.
# Never commit the proxy URL because it contains credentials.
# PRA_PROXY_URL=http://user:password@proxy.example.com:9293
# Comma-separated public IPs shown to owners for the PRA whitelist request.
PRA_STATIC_IPS=34.232.217.139,18.213.181.255

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Mongo connection-pool safety limits. Tenant databases are opened on demand;
# keep each tenant pool intentionally small and tune only from measured load.
MONGO_PLATFORM_MAX_POOL_SIZE=10
MONGO_TENANT_MAX_POOL_SIZE=5
MONGO_MAX_IDLE_TIME_MS=60000
MONGO_WAIT_QUEUE_TIMEOUT_MS=10000

# ─── Durable workers (disabled until the Heroku Redis plan is verified) ───────
# Prefer a dedicated durable/HA Redis instance for queues. REDIS_URL is accepted
# as a compatibility fallback, but QUEUE_REDIS_URL keeps queue policy separate
# from disposable caches and Socket.IO traffic.
PRA_QUEUE_ENABLED=false
# Optional scheduler override. Defaults to every 10 minutes when the scheduler runs.
# PRA_RETRY_CRON=*/10 * * * *
# Offloads GPS point persistence, route calculations, device updates, and
# geofence/run transitions to the dedicated worker-tracking dyno. If Redis is
# temporarily unavailable, the API falls back to inline processing.
RIDER_TRACKING_QUEUE_ENABLED=false
# QUEUE_REDIS_URL=rediss://default:password@host:port
PRA_WORKER_CONCURRENCY=5
# Keep one FIFO processor per worker dyno. Scale only after introducing
# partitioned per-rider ordering; out-of-order GPS batches corrupt distance.
RIDER_TRACKING_WORKER_CONCURRENCY=1

# Distributed Socket.IO and rate limiting stay off until the live Redis plan,
# connection budget, and Heroku session-affinity setting have been verified.
SOCKET_REDIS_ENABLED=false
# SOCKET_REDIS_URL=rediss://default:password@host:port
DISTRIBUTED_RATE_LIMIT_ENABLED=false
# RATE_LIMIT_REDIS_URL=rediss://default:password@host:port
PUBLIC_RATE_LIMIT_MAX=120

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slashes).
# Public QR self-order endpoints (/api/public/*) accept any origin —
# this list is for the authenticated management/admin/POS frontends.
CLIENT_URL=http://localhost:3000,http://localhost:3001

# ─── Scheduled jobs (run by `npm run jobs:scheduler`) ────────────────────────
# Cron expression for the overdue-invoice sweep. Required when running the
# scheduler worker. Example: "*/5 * * * *" (every 5 min).
OVERDUE_CRON="0 */10 * * * *"

# Optional cron expression for the loyalty-points expiry sweep. Defaults
# to "15 3 * * *" (daily at 03:15) if omitted while the scheduler is running.
# Tenants whose membershipRewards flag is off are skipped inside the job.
# LOYALTY_EXPIRY_CRON="15 3 * * *"
# Optional. The long-running scheduler scans hourly by default; per-invoice
# nextReminderAt keeps successful billing emails at least 24 hours apart.
# BILLING_REMINDER_CRON="7 * * * *"

# Subscription billing / Mailtrap
MAILTRAP_TOKEN=<YOUR_API_TOKEN>
MAILTRAP_SENDER_EMAIL=hello@cenciss.com
# Paste the UUID shown on the Mailtrap transactional template Integration tab.
# Billing emails remain disabled until this Mailtrap-hosted template is set.
BILLING_MAILTRAP_TEMPLATE_UUID=6a3e2986-79ba-49b7-b3a0-f9d21598867e
BILLING_COMPANY_NAME=Cenciss
BILLING_TIMEZONE=Asia/Karachi
